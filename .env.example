# Processor mode: "local" or "lambda"
XBEACH_PROCESSOR_MODE=local

# Required when XBEACH_PROCESSOR_MODE=lambda
XBEACH_RETRIEVER_LAMBDA_FUNCTION_NAME=xbeach-retriever

# ARPAE FTPS server credentials (required for data retrieval)
FTPS_ARPAE_HOST=
FTPS_ARPAE_USERNAME=
FTPS_ARPAE_PASSWORD=

# AWS configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# API token for the pygeoapi process
INT_API_TOKEN=token
